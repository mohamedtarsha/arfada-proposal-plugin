# Environment and secrets — NEVER commit these
.env
.env.*
*.key
*.pem
*.p12
credentials.json
*service-account*.json

# Google OAuth material — NEVER commit (tokens, client secrets)
client_secret*.json
token.json
*oauth*token*
.arfada-proposal/

# Live knowledge cache + downloaded CVs (user-local; never committed)
# (cache lives under ~/.arfada-proposal/, already excluded above; these guard
#  against an accidental in-repo copy)
knowledge_cache/
**/staff_index.json
**/source_state.json

# The team-shared source manifest may be committed (IDs only); the real one is
# arfada_sources.yaml — keep ONLY the .example in Git by default.
config/arfada_sources.yaml

# Proposal and TOR data — confidential client material
tors/
proposals/
outputs/
drafts/
*.tor
# Note: synthetic test fixtures (*.docx, *.pdf in tests/fixtures/) are ALLOWED
# Real TOR documents must NEVER be committed — add them here if accidentally staged:
# *.docx
# *.pdf
*.xlsx
*.csv
data/

# TOR analysis output — always local, never committed
arfada-output/

# Development databases
*.db
*.sqlite
*.duckdb
db/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.mcp_deps/
*.egg-info/
dist/
build/

# Node / JS (if tooling added later)
node_modules/
.npm

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code local state
.claude/settings.local.json
